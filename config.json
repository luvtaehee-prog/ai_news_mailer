{
  "news_sources": {
    "google": {
      "type": "rss",
      "url": "https://news.google.com/rss/search?q=AI&hl=ko&gl=KR&ceid=KR:ko",
      "max_retries": 3,
      "retry_delay": 5
    },
    "naver": {
      "type": "api",
      "url": "https://naverapihub.apigw.ntruss.com/search/v1/news",
      "keywords": [
        "AI",
        "인공지능",
        "생성형 AI",
        "LLM",
        "AI 반도체"
      ]
    },
    "govuk": {
      "type": "crawl",
      "url": "https://www.gov.uk/search/news-and-communications?parent=%2Fbusiness-and-industry%2Fartificial-intelligence&topic=7a4fba0a-f8d5-4aed-9d73-8a455c6ba7ac",
      "request_delay": 1
    }
  },

  "request": {
    "timeout": 10
  },

  "ai": {
    "model": "gpt-5.4"
  },

  "duplicate_policy": "skip",

  "paths": {
    "raw": "data/raw",
    "clean": "data/clean",
    "analyzed": "data/analyzed"
  },

  "report": {
    "output_directory": "output",
    "top_n": 10,
    "date_field": "published"
  },

  "clean": {
    "min_title_length": 2,
    "max_content_length": 3000,
    "dedup_by_title": true,
    "press_in_title_sources": ["google"],
    "category_by_source": {
      "google": "IT",
      "naver": "IT",
      "gov.uk": "정책/정부"
    },
    "default_category": "미분류"
  }
}